{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formstash",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/f/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "formstash",
      "database_id": "6fe291de-7e69-4651-be32-c0fb53e6ea57",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "waitinglist.owsproject.com",
      "custom_domain": true
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_QUEUE",
        "queue": "formstash-email"
      }
    ],
    "consumers": [
      {
        "queue": "formstash-email",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 4,
        "dead_letter_queue": "formstash-email-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
