{
  "name": "formstash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "wrangler dev",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply formstash --local",
    "db:migrate:remote": "wrangler d1 migrations apply formstash --remote",
    "db:migrate:preview": "wrangler d1 migrations apply formstash-preview --remote --config wrangler.preview-migrations.jsonc",
    "deploy": "pnpm build && wrangler deploy",
    "ci:build": "pnpm typecheck && pnpm test && pnpm build",
    "ci:deploy": "pnpm db:migrate:remote && wrangler deploy",
    "ci:preview": "pnpm db:migrate:preview && wrangler preview"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.9.8",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.7.0",
    "re2js": "^2.8.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.2"
  },
  "packageManager": "pnpm@10.17.1"
}
